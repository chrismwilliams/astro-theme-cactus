		venue: "Proc. ACM Hum.-Comput. Interact. 7, CSCW",
		year: "2023",
		link: "https://doi.org/10.1145/3579614",
		project: "/posts/ai-coaching#understanding-coaching-expertise",
	},
	{
		title: "Designing a Model for Deliberation-based Learning",
		authors: "Spencer Carlson, Kristine Lu, Evey Huang, Elizabeth Gerber, Matthew Easterday",
		venue: "International Conference of the Learning Sciences",
		year: "2020",
		link: "https://www.researchgate.net/publication/339912236_Designing_a_Model_for_Deliberation-Based_Learning",
	},
	{
		title: "Interacting with Literary Style through Computational Tools",
		authors: "Sarah Sterman, Evey Huang, Vivian Liu, Eric Paulos",
		venue: "CHI Conference on Human Factors in Computing Systems",
		year: "2020",
		link: "https://doi.org/10.1145/3313831.3376730",
		project: "/posts/ai-coaching#early-work-on-tacit-judgment",
	},
	{
		title: "No More One Liners: Bringing Context into Emoji Recommendations",
		authors:
			"Joon-Gyum Kim, Taesik Gong, Bogoan Kim, JaeYeon Park, Woojeong Kim, Evey Huang, Kyungsik Han, Juho Kim, JeongGil Ko, Sung-Ju Lee",
		venue: "ACM Transactions on Social Computing",
		year: "2019",
		link: "https://dl.acm.org/doi/abs/10.1145/3373146",
	},
];

const workshopsAndPresentations: Paper[] = [
	{
		title: "Evaluating Multimodal Language Models for Annotating Team Behaviors in Videos",
		authors: "Evey Huang, Matt Groh, Danny Abrams, Brian Uzzi",
		venue: "11th International Conference on Computational Social Science (IC2S2 2025)",
		project: "/posts/ai-team-science#scientific-teams",
		year: "2025",
	},

	{
		title: "Supporting Workers in Developing Effective Collaboration Skills for Complex Work",
		authors: "Evey Huang, K. Garg, D. Gómez-Zará, J. Hui, C. Kulkarni, M. Massimi, E. F. Churchill, Elizabeth Gerber",
		venue: "CSCW Companion, 486–489",
		year: "2023",
		status: "Workshop proposal",
		link: "https://doi.org/10.1145/3584931.3611290",
		project: "/posts/ai-coaching#learning-to-collaborate",
	},

	{
		title: "Designing Intelligent Coaching Systems to Support Equitable Engagement in Making",
		authors: "Evey Huang, Matthew Easterday, Elizabeth Gerber",
		venue: "CHI '22 workshop on Learning Hands-on Creative and Maker Skills",
		year: "2022",
		link: "https://drive.google.com/file/d/1YXq4ev17ana0sbxdgX2ie0BwLN9uLEDG/view?usp=sharing",
	},
	{
		title: "Encouraging Disagreements to Integrate Diversity in Collective Intelligence",
		authors: "Evey Huang, Matthew Easterday, Elizabeth Gerber",
		venue: "CHI '20 workshop on Effective Activism for Change",
		year: "2020",
	},
];


const workInProgress: Paper[] = [
	{
		title: "Double Compression: How AI Narrows Both the Generation and the Gatekeeping of Scientific Ideas",
		authors: "Evey Huang, Matt Groh, Brian Uzzi",
		venue: "Working manuscript",
		year: "In preparation",
		project: "/posts/double-compression",
	},
	{
		title: "Multimodal AI for Large-Scale Scientific Team Behavior Analysis",
		authors: "Evey Huang, Max Chalekson, Matt Groh, D. Abrams, Brian Uzzi",
		venue: "Working manuscript",
		year: "In preparation",
		project: "/posts/ai-team-science#scientific-teams",
	},
	{
		title: "Revealed Preparedness: Measuring Entrepreneur–Investor Interaction at Scale with Multimodal AI",
		authors: "Evey Huang, A. Grey, Brian Uzzi, Matt Groh",
		venue: "Entrepreneur–investor interaction",
		year: "Ongoing study",
		project: "/posts/ai-team-science#entrepreneurinvestor-interaction",
	},
];

const dissertation = {
	title:
		"Human-AI Collaboration For Entrepreneurship Coaching: Leveraging a Cognitive Model and an LLM to Provide Proactive, Adaptive, and Differentiated Support",
	authors: "Evey Huang",
	venue: "Doctoral dissertation",
	year: "2024",
	link: "https://www.proquest.com/openview/d0591dc834a0e8bf80c41883948c8e5d/1?cbl=18750&diss=y&pq-origsite=gscholar",
};

const meta = {
	title: "Publications",
	description: "Publications, forthcoming work, research in progress, workshop papers, and dissertation",
};
---

<PageLayout meta={meta}>
	<section>
		<div class="section-head">
			<h1>Publications</h1>
			<p class="section-label">Research Output</p>
		</div>
		<p class="max-w-3xl text-[1.03rem] text-muted">
			Papers and ongoing studies on AI and collective work, spanning human-computer interaction, computational social science, and organizational research.
		</p>
	</section>

	<section class="section-block">
		<div class="section-head">
			<h2>Journal & Conference Papers</h2>
			<p class="section-label">Published and forthcoming</p>
		</div>
		<ul class="space-y-5">
			{
				conferenceAndJournalPapers.map((paper, index) => (
					<li class="border-t border-dashed border-line pt-4">
						<p>
							[{index + 1}] <strong>{paper.title}</strong>
						</p>
						<p class="text-sm text-muted">{paper.authors}</p>
						<p class="text-sm text-muted">{paper.year}. {paper.venue}</p>
						{paper.status && <p class="text-sm text-muted">{paper.status}</p>}
						{paper.project && <a class="cactus-link mr-4 text-sm" href={paper.project}>Project overview</a>}
						{
							paper.link && (
								<a class="cactus-link text-sm" href={paper.link} target="_blank" rel="noopener noreferrer">
									View publication
								</a>
							)
						}
					</li>
				))
			}
		</ul>
	</section>


	<section class="section-block">
		<div class="section-head">
			<h2>Research in Progress</h2>
			<p class="section-label">Manuscripts and ongoing studies</p>
		</div>
		<ul class="space-y-5">
			{workInProgress.map((paper) => (
				<li class="border-t border-dashed border-line pt-4">
					<p><strong>{paper.title}</strong></p>
					<p class="text-sm text-muted">{paper.authors}</p>
					<p class="text-sm text-muted">{paper.venue} · {paper.year}</p>
					<a class="cactus-link text-sm" href={paper.project}>Project overview</a>
				</li>
			))}
		</ul>
		<p class="mt-5 text-sm text-muted">I also study <a class="cactus-link" href="/posts/ai-team-science#professional-volleyball">cohesion in professional volleyball teams</a> as part of my ongoing work on team interaction.</p>
	</section>

	<section class="section-block">
		<div class="section-head">
			<h2>Workshop & Conference Presentations</h2>
			<p class="section-label">Workshops and presentations</p>
		</div>
		<ul class="space-y-5">
			{
				workshopsAndPresentations.map((paper, index) => (
					<li class="border-t border-dashed border-line pt-4">
						<p>
							[{index + 1}] <strong>{paper.title}</strong>
						</p>
						<p class="text-sm text-muted">{paper.authors}</p>
						<p class="text-sm text-muted">{paper.year}. {paper.venue}</p>
						{paper.status && <p class="text-sm text-muted">{paper.status}</p>}
						{paper.project && <a class="cactus-link mr-4 text-sm" href={paper.project}>Project overview</a>}
						{
							paper.link && (
								<a class="cactus-link text-sm" href={paper.link} target="_blank" rel="noopener noreferrer">
									View material
								</a>
							)
						}
					</li>
				))
			}
		</ul>
	</section>

	<section class="section-block">
		<div class="section-head">
			<h2>Dissertation</h2>
			<p class="section-label">Doctoral work</p>
		</div>
		<ul class="space-y-5">
			<li class="border-t border-dashed border-line pt-4">
				<p>
					[1] <strong>{dissertation.title}</strong>
				</p>
				<p class="text-sm text-muted">{dissertation.authors}</p>
				<p class="text-sm text-muted">{dissertation.year}. {dissertation.venue}</p>
				<a
					class="cactus-link text-sm"
					href={dissertation.link}
					target="_blank"
					rel="noopener noreferrer"
				>
					View dissertation
				</a>
			</li>
		</ul>
	</section>
</PageLayout>
