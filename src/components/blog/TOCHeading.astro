---
import type { TocItem } from "@/utils/generateToc";

interface Props {
	heading: TocItem;
}

const {
	heading: { children, depth, slug, text },
} = Astro.props;
---

<li>
	<a
		class:list={[
			"text-muted hover:text-accent-2 -ms-px block border-s-2 border-transparent py-1.5 text-[13px] leading-snug transition-colors",
			"data-[done=true]:text-global-text data-[active=true]:border-accent data-[active=true]:text-accent-strong data-[active=true]:font-semibold",
			depth > 2 ? "ps-7 text-[12.5px]" : "ps-3.5",
		]}
		data-toc-link={slug}
		href={`#${slug}`}>{text}</a
	>
	{
		!!children.length && (
			<ol>
				{children.map((subheading) => (
					<Astro.self heading={subheading} />
				))}
			</ol>
		)
	}
</li>
