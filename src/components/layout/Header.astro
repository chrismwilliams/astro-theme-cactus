---
import Search from "@/components/Search.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { menuLinks, siteConfig } from "@/site.config";

const isActive = (path: string) =>
	path === "/" ? Astro.url.pathname === "/" : Astro.url.pathname.startsWith(path);
---

<header
	class="group border-line bg-global-bg/80 sticky top-0 z-40 border-b backdrop-blur-md"
	id="main-header"
>
	<div class="mx-auto flex h-16 max-w-6xl items-center gap-3 px-4 sm:px-6 md:gap-4 lg:gap-6 lg:px-8">
		<a
			aria-current={Astro.url.pathname === "/" ? "page" : false}
			class="text-accent-2 flex shrink-0 items-center gap-2.5 font-mono text-base font-bold"
			href="/"
		>
			{
				siteConfig.showLogo && (
					<span
						aria-hidden="true"
						class="bg-accent-2 text-accent dark:bg-accent-soft grid h-8 w-8 place-items-center rounded-lg text-sm"
					>
						D
					</span>
				)
			}
			<span class="max-[339px]:sr-only">{siteConfig.title.toLowerCase()}</span>
		</a>
		<nav
			aria-label="Main"
			class="bg-global-bg border-line absolute inset-x-0 top-16 hidden flex-col border-b px-4 py-2 font-mono text-sm group-[.menu-open]:flex md:static md:flex md:flex-row md:gap-0.5 md:border-0 md:bg-transparent md:p-0"
			id="navigation-menu"
		>
			{
				menuLinks.map((link) => (
					<a
						aria-current={isActive(link.path) ? "page" : false}
						class="text-muted hover:text-accent-2 aria-[current=page]:text-accent-2 aria-[current=page]:bg-surface-2 rounded-lg px-3 py-3 md:px-2.5 md:py-1.5 lg:px-3"
						href={link.path}
					>
						{link.title.toLowerCase()}
					</a>
				))
			}
		</nav>
		<div class="ms-auto flex shrink-0 items-center gap-1.5 sm:gap-2">
			<Search />
			<ThemeToggle />
			<a class="icon-btn hidden lg:inline-flex" href="/rss.xml" target="_blank">
				<span class="sr-only">RSS feed</span>
				<svg
					aria-hidden="true"
					class="h-[18px] w-[18px]"
					fill="none"
					stroke="currentColor"
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="1.8"
					viewBox="0 0 24 24"
					><path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"
					></circle></svg
				>
			</a>
			<mobile-button>
				<button
					aria-expanded="false"
					aria-haspopup="menu"
					class="icon-btn md:hidden"
					id="toggle-navigation-menu"
					type="button"
				>
					<span class="sr-only">Open main menu</span>
					<span aria-hidden="true" class="burger"><i></i><i></i><i></i></span>
				</button>
			</mobile-button>
		</div>
	</div>
</header>

<script>
	import { toggleClass } from "@/utils/domElement";
	import { popIn, popOut } from "@/utils/motion";

	class MobileNavBtn extends HTMLElement {
		#menuOpen: boolean = false;

		connectedCallback() {
			const headerEl = document.getElementById("main-header")!;
			const mobileButtonEl = this.querySelector<HTMLButtonElement>("button");

			const nav = document.getElementById("navigation-menu");
			mobileButtonEl?.addEventListener("click", () => {
				this.#menuOpen = !this.#menuOpen;
				mobileButtonEl.setAttribute("aria-expanded", this.#menuOpen.toString());
				if (this.#menuOpen) {
					if (headerEl) toggleClass(headerEl, "menu-open");
					if (nav) popIn(nav, "top right");
				} else if (nav) {
					popOut(nav, () => {
						if (!this.#menuOpen && headerEl) headerEl.classList.remove("menu-open");
					});
				}
			});
		}
	}

	customElements.define("mobile-button", MobileNavBtn);
</script>

<style>
	/* hamburger -> close: lines meet (150 ms), then rotate (150 ms); reversed on close */
	.burger {
		position: relative;
		width: 16px;
		height: 12px;
	}
	.burger i {
		position: absolute;
		left: 0;
		width: 100%;
		height: 1.8px;
		border-radius: 2px;
		background: currentColor;
		transition:
			translate 150ms var(--ease-in-out) 150ms,
			rotate 150ms var(--ease-in-out),
			opacity 100ms linear 150ms;
	}
	.burger i:nth-child(1) {
		top: 0;
	}
	.burger i:nth-child(2) {
		top: 5px;
	}
	.burger i:nth-child(3) {
		top: 10px;
	}
	[aria-expanded="true"] .burger i {
		transition:
			translate 150ms var(--ease-in-out),
			rotate 150ms var(--ease-in-out) 150ms,
			opacity 100ms linear;
	}
	[aria-expanded="true"] .burger i:nth-child(1) {
		translate: 0 5px;
		rotate: 45deg;
	}
	[aria-expanded="true"] .burger i:nth-child(2) {
		opacity: 0;
	}
	[aria-expanded="true"] .burger i:nth-child(3) {
		translate: 0 -5px;
		rotate: -45deg;
	}
</style>
