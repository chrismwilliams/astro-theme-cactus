---
import PageLayout from "@/layouts/Base";

type Paper = {
	title: string;
	authors: string;
	venue: string;
	year: string;
	link?: string;
	project?: string;
	status?: string;
};

const conferenceAndJournalPapers: Paper[] = [
	{
		title: "Measuring What Matters in Teams with Multimodal AI",
		authors: "Evey Huang, Brian Uzzi, Matt Groh",
		venue: "Journal of Organization Design",
		year: "2026",
		status: "To appear · Perspective article",
		project: "/posts/ai-team-science",
	},
	{
		title:
			"AI That Helps Us Help Each Other: A Proactive System for Scaffolding Mentor-Novice Collaboration in Entrepreneurship Coaching",
		authors: "Evey Huang, Matthew Easterday, Elizabeth Gerber",
		venue: "Proceedings of the ACM on Human-Computer Interaction, 9(7), CSCW368",
		year: "2025",
