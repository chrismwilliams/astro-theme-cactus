---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import PageLayout from "@/layouts/Base";
import PostPreview from "@/components/blog/PostPreview";

export async function getStaticPaths() {
	const posts = await getCollection("post", ({ data }) => !data.draft);
	return [{ params: { page: undefined }, props: { posts } }];
}

interface Props {
	posts: CollectionEntry<"post">[];
}

const { posts } = Astro.props;
const orderedPosts = [...posts].sort((a, b) => a.data.order - b.data.order);
---

<PageLayout meta={{ title: "Research", description: "Research on AI and collective work: making expertise usable, understanding collaboration, and evaluating collective outcomes." }}>
	<section>
		<div class="section-head">
			<h1>Research and projects</h1>
			<p class="section-label">AI and collective work</p>
		</div>
		<p class="max-w-3xl text-[1.02rem] text-muted">
			I bring methods from human-computer interaction (HCI) and computational social science (CSS) to these organizational questions, while using advances in AI both to study collective work and to change how it happens. My approach connects field observation of how people work, computational analysis of the patterns of work that emerge at scale, and design of new systems that allow me to intervene in those same processes. Together, these methods allow me to move from uncovering organizational processes that are difficult to capture in conventional data, to measuring and modeling them at scale, to designing and testing interventions that change how people collaborate. 
		</p>
	</section>

	<section class="section-block max-w-4xl" aria-label="Research streams and industry work">
		<ul class="post-list text-start">
			{orderedPosts.map((post) => (
				<li class="post-list-item"><PostPreview post={post} as="h2" withDesc /></li>
			))}
		</ul>
		<p class="mt-6 text-sm"><a class="cactus-link" href="/publications">View all publications and manuscripts</a></p>
	</section>
</PageLayout>
