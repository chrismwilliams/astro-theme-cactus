---
/**
 * AI Summary button — calls /api/summarize (Cloudflare Workers AI)
 * to generate a summary of the blog post content.
 */
---

<ai-summary>
	<div
		class="border-accent/45 bg-accent-soft mt-8 mb-2 overflow-hidden rounded-2xl border"
	>
		<button
			class="text-accent-strong flex w-full cursor-pointer items-center gap-2 px-5 py-3.5 font-mono text-[13px] font-semibold transition-colors hover:bg-accent/10"
			id="ai-summary-btn"
			type="button"
		>
			<svg
				aria-hidden="true"
				class="h-5 w-5"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				viewBox="0 0 24 24"
				xmlns="http://www.w3.org/2000/svg"
			>
				<path
					d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z"
					stroke-linecap="round"
					stroke-linejoin="round"
				></path>
			</svg>
			<span id="ai-summary-label">TL;DR — tóm tắt bằng AI</span>
			<span class="text-muted ms-auto font-normal" id="ai-summary-hint">bấm để tạo</span>
			<svg
				aria-hidden="true"
				class="ms-auto hidden h-4 w-4 animate-spin"
				fill="none"
				id="ai-summary-spinner"
				viewBox="0 0 24 24"
				xmlns="http://www.w3.org/2000/svg"
			>
				<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
				<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
			</svg>
		</button>
		<div class="ai-acc" data-open="false">
			<div class="min-h-0 overflow-hidden">
				<div class="border-accent/30 border-t px-5 py-4 text-[15px] leading-relaxed" id="ai-summary-result"></div>
			</div>
		</div>
	</div>
</ai-summary>

<script>
	class AiSummary extends HTMLElement {
		#generated = false;

		connectedCallback() {
			const btn = this.querySelector<HTMLButtonElement>("#ai-summary-btn")!;
			const label = this.querySelector<HTMLSpanElement>("#ai-summary-label")!;
			const spinner = this.querySelector<SVGElement>("#ai-summary-spinner")!;
			const result = this.querySelector<HTMLDivElement>("#ai-summary-result")!;
			const acc = this.querySelector<HTMLDivElement>(".ai-acc")!;
			const hint = this.querySelector<HTMLSpanElement>("#ai-summary-hint")!;

			btn.addEventListener("click", async () => {
				// Toggle visibility if already generated
				if (this.#generated) {
					acc.dataset.open = String(acc.dataset.open !== "true");
					return;
				}

				hint.classList.add("hidden");
				label.textContent = "Đang tóm tắt...";
				spinner.classList.remove("hidden");
				btn.disabled = true;

				try {
					const path = location.pathname.endsWith("/") ? location.pathname : `${location.pathname}/`;
					const res = await fetch("/api/summary", {
						body: JSON.stringify({ path }),
						headers: { "Content-Type": "application/json" },
						method: "POST",
					});
					const data = (await res.json().catch(() => ({}))) as { summary?: string; message?: string };
					if (!res.ok || !data.summary) throw new Error(data.message ?? `HTTP ${res.status}`);

					// render "- item" lines as a list, as text only
					const lines = data.summary
						.split("\n")
						.map((l) => l.replace(/^\s*(?:[-*•]|\d+[.)])\s*/, "").trim())
						.filter(Boolean);
					const list = document.createElement("ul");
					list.className = "list-disc space-y-1.5 ps-5";
					for (const line of lines) {
						const li = document.createElement("li");
						li.textContent = line.replace(/\*\*(.+?)\*\*/g, "$1");
						list.append(li);
					}
					result.replaceChildren(list);
					acc.dataset.open = "true";
					this.#generated = true;
				} catch (err) {
					result.textContent = `⚠️ ${(err as Error).message || "Lỗi khi tóm tắt. Vui lòng thử lại sau."}`;
					acc.dataset.open = "true";
				} finally {
					label.textContent = "TL;DR — tóm tắt bằng AI";
					spinner.classList.add("hidden");
					btn.disabled = false;
				}
			});
		}
	}

	customElements.define("ai-summary", AiSummary);
</script>

<style>
	/* accordion: animate the grid row so the browser supplies the real height */
	.ai-acc {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows var(--dur-panel) var(--ease-out);
	}
	.ai-acc[data-open="true"] {
		grid-template-rows: 1fr;
	}
</style>
