---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";
import { siteConfig } from "@/site.config";

interface Props {
	content: CollectionEntry<"post">;
	readingTime: string;
}

const {
	content: { data },
	readingTime,
} = Astro.props;
const initials = siteConfig.author
	.split(" ")
	.map((w) => w[0])
	.slice(-1)
	.join("");
---

<nav aria-label="Breadcrumb" class="text-muted mb-4 font-mono text-xs">
	<a class="hover:text-accent-2" href="/posts/">blog</a>
	{
		data.tags[0] && (
			<>
				{" / "}
				<a class="hover:text-accent-2" href={`/tags/${data.tags[0]}/`}>
					{data.tags[0]}
				</a>
			</>
		)
	}
</nav>
{data.draft ? <span class="text-base text-red-500">(Draft)</span> : null}
<h1 class="text-accent-2 text-3xl leading-[1.15] font-extrabold tracking-tight sm:text-[2.5rem]">
	{data.title}
</h1>
<p class="text-muted mt-4 text-lg">{data.description}</p>
<div class="border-line mt-6 flex flex-wrap items-center gap-x-3 gap-y-3 border-y py-4">
	<span
		aria-hidden="true"
		class="bg-accent-2 text-accent dark:bg-accent-soft grid h-10 w-10 place-items-center rounded-full font-mono font-bold"
		>{initials}</span
	>
	<div class="leading-tight">
		<p class="text-accent-2 text-sm font-semibold">{siteConfig.author}</p>
		<p class="text-muted font-mono text-xs">
			<FormattedDate date={data.publishDate} /> · {readingTime}
			{
				data.updatedDate && (
					<>
						{" · cập nhật "}
						<FormattedDate date={data.updatedDate} />
					</>
				)
			}
		</p>
	</div>
	{
		!!data.tags.length && (
			<ul class="flex flex-wrap gap-x-3 gap-y-1 sm:ms-auto">
				{data.tags.map((tag) => (
					<li>
						<a class="tag-link" data-pagefind-filter={`tag:${tag}`} href={`/tags/${tag}/`}>
							<span class="sr-only">Xem bài với tag </span>#{tag}
						</a>
					</li>
				))}
			</ul>
		)
	}
</div>
{
	data.coverImage && (
		<div class="mt-7 overflow-hidden rounded-2xl">
			<Image
				alt={data.coverImage.alt}
				class="w-full"
				layout="constrained"
				width={1000}
				height={560}
				priority
				src={data.coverImage.src}
			/>
		</div>
	)
}
