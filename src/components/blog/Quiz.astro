---
/**
 * Inline quiz / poll for MDX posts.
 *
 * <Quiz id="jwt-alg" question="Đoạn nào an toàn?" options={["a", "b", "c"]} answer={1} />
 *
 * - `answer` (index) makes it a quiz: the correct option is revealed after a pick.
 * - Without `answer` it is a poll.
 * - `id` must be unique across the site: it keys the vote counts in KV.
 */
interface Props {
	id: string;
	question: string;
	options: string[];
	answer?: number;
	explain?: string;
}

const { id, question, options, answer, explain } = Astro.props;
---

<blog-quiz
	class="card not-prose my-8 block p-5"
	data-answer={answer ?? ""}
	data-quiz-id={id}
>
	<p class="text-accent-2 mb-3 font-semibold">{answer !== undefined ? "🧠 " : "📊 "}{question}</p>
	<div class="space-y-2" role="group" aria-label={question}>
		{
			options.map((opt, i) => (
				<button
					class="border-line hover:border-accent data-[state=correct]:border-accent data-[state=correct]:bg-accent-soft data-[state=wrong]:text-muted data-[state=wrong]:border-red-400/60 data-[state=picked]:border-accent relative flex w-full cursor-pointer items-center justify-between gap-3 overflow-hidden rounded-xl border px-4 py-2.5 text-start text-sm transition disabled:cursor-default"
					data-option={i}
					type="button"
				>
					<span
						aria-hidden="true"
						class="bg-accent/12 absolute inset-y-0 start-0 w-0 transition-[width] duration-500"
						data-bar
					/>
					<span class="relative font-mono">{opt}</span>
					<span class="text-muted relative shrink-0 font-mono text-xs" data-pct />
				</button>
			))
		}
	</div>
	{explain && (
		<p class="text-muted mt-3 hidden text-sm" data-explain>
			💡 {explain}
		</p>
	)}
</blog-quiz>

<script>
	class BlogQuiz extends HTMLElement {
		connectedCallback() {
			const id = this.dataset.quizId!;
			const answer = this.dataset.answer === "" ? null : Number(this.dataset.answer);
			const buttons = [...this.querySelectorAll<HTMLButtonElement>("[data-option]")];
			const storeKey = `reader:quiz:${id}`;

			const reveal = (picked: number, counts: number[] | null) => {
				const total = counts?.reduce((a, b) => a + b, 0) ?? 0;
				buttons.forEach((b, i) => {
					b.disabled = true;
					if (answer !== null) {
						if (i === answer) b.dataset.state = "correct";
						else if (i === picked) b.dataset.state = "wrong";
					} else if (i === picked) {
						b.dataset.state = "picked";
					}
					const pctEl = b.querySelector<HTMLElement>("[data-pct]")!;
					const bar = b.querySelector<HTMLElement>("[data-bar]")!;
					if (total > 0 && counts) {
						const pct = Math.round(((counts[i] ?? 0) / total) * 100);
						bar.style.width = `${pct}%`;
						pctEl.textContent = `${i === answer ? "✓ " : ""}${pct}%`;
					} else {
						pctEl.textContent = i === answer ? "✓" : i === picked && answer !== null ? "✗" : "";
					}
				});
				this.querySelector("[data-explain]")?.classList.remove("hidden");
			};

			let previous: number | null = null;
			try {
				const v = localStorage.getItem(storeKey);
				previous = v === null ? null : Number(v);
			} catch {}

			if (previous !== null) {
				fetch(`/api/quiz?id=${encodeURIComponent(id)}`)
					.then((r) => (r.ok ? r.json() : null))
					.then((c: { counts?: number[] } | null) => reveal(previous!, c?.counts ?? null))
					.catch(() => reveal(previous!, null));
				reveal(previous, null);
			}

			buttons.forEach((b, i) => {
				b.addEventListener("click", async () => {
					try {
						localStorage.setItem(storeKey, String(i));
					} catch {}
					reveal(i, null);
					try {
						const res = await fetch("/api/quiz", {
							body: JSON.stringify({ choice: i, id, options: buttons.length }),
							headers: { "Content-Type": "application/json" },
							method: "POST",
						});
						if (res.ok) reveal(i, ((await res.json()) as { counts: number[] }).counts);
					} catch {}
				});
			});
		}
	}
	customElements.define("blog-quiz", BlogQuiz);
</script>
