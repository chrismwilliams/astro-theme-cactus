{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "blog",
	"workers_dev": false,
	"preview_urls": false,
	"compatibility_date": "2026-09-14",
	"main": "functions/api/summarize.ts",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page",
		"binding": "ASSETS"
	},
	"ai": {
		"binding": "AI"
	},
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": false,
			"head_sampling_rate": 1,
			"persist": true
		}
	},
	"kv_namespaces": [
		{
			"binding": "BLOG_KV",
			"id": "72f3bbee88b4414b8839b2a7bd7fad11"
		}
	],
	"keep_vars": true
}
